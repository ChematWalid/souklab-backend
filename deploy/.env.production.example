# Copy to deploy/.env.production, chmod 600, and replace every placeholder.
COMPOSE_PROJECT_NAME=souklab-production
MARIADB_HOST_PORT=3306
APP_IMAGE=ghcr.io/your-org/souklab@sha256:replace-with-published-digest
PUBLIC_DOMAIN=api.example.com
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-secret
BACKUP_METRICS_PUSHGATEWAY=http://127.0.0.1:9091
DB_NAME=souklab
DB_USERNAME=replace-with-db-user
DB_PASSWORD=replace-with-db-password
DB_ROOT_PASSWORD=replace-with-db-root-password
DB_URL=jdbc:mariadb://mariadb:3306/souklab
RABBITMQ_DEFAULT_USER=replace-with-rabbit-user
RABBITMQ_DEFAULT_PASS=replace-with-rabbit-password
REDIS_PASSWORD=replace-with-redis-password
APP_RATE_LIMIT_KEY_PREFIX=souklab:prod
APP_RATE_LIMIT_BACKEND=redis
REDIS_CONNECTION_TIMEOUT=2000
REDIS_COMMAND_TIMEOUT=1000
APP_JWT_SECRET=replace-with-at-least-32-random-characters
APP_CORS_ALLOWED_ORIGINS=https://www.example.com
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_CAPACITY=100
APP_RATE_LIMIT_REFILL_DURATION=1m
APP_RATE_LIMIT_USER_ENABLED=true
APP_RATE_LIMIT_USER_CAPACITY=120
APP_RATE_LIMIT_USER_REFILL_DURATION=1m
# Endpoint-specific authenticated-user limits; unset classes fall back to the
# global APP_RATE_LIMIT_USER_* policy.
RATE_LIMIT_AUTH_USER_CAPACITY=120
RATE_LIMIT_AUTH_USER_REFILL_DURATION=1m
RATE_LIMIT_PUBLIC_USER_CAPACITY=120
RATE_LIMIT_PUBLIC_USER_REFILL_DURATION=1m
RATE_LIMIT_ADMIN_USER_CAPACITY=60
RATE_LIMIT_ADMIN_USER_REFILL_DURATION=1m
RATE_LIMIT_ANALYTICS_USER_CAPACITY=20
RATE_LIMIT_ANALYTICS_USER_REFILL_DURATION=1m
RATE_LIMIT_ANALYTICS_RESULTS_USER_CAPACITY=60
RATE_LIMIT_ANALYTICS_RESULTS_USER_REFILL_DURATION=1m
RATE_LIMIT_CSV_USER_CAPACITY=10
RATE_LIMIT_CSV_USER_REFILL_DURATION=1m
RATE_LIMIT_WEBHOOK_USER_CAPACITY=120
RATE_LIMIT_WEBHOOK_USER_REFILL_DURATION=1m
STORAGE_PROVIDER=s3
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=replace-with-existing-bucket
STORAGE_S3_ACCESS_KEY=replace-with-least-privilege-key
STORAGE_S3_SECRET_KEY=replace-with-least-privilege-secret
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-minio-root-password
STORAGE_S3_PATH_STYLE_ACCESS=false
STORAGE_S3_AUTO_CREATE_BUCKET=false
STORAGE_VIRUS_SCAN_ENABLED=true
STORAGE_VIRUS_SCAN_FAIL_OPEN=false
HIBERNATE_SEARCH_ENABLED=true
ELASTICSEARCH_URIS=http://elasticsearch:9200
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
HIBERNATE_SEARCH_SCHEMA_MANAGEMENT=validate
SEARCH_SCHEMA_BOOTSTRAP_ENABLED=false
APP_ADMIN_BOOTSTRAP_ENABLED=false
FLYWAY_ENABLED=true
JPA_HIBERNATE_DDL_AUTO=validate
PAGEABLE_DEFAULT_SIZE=20
PAGEABLE_MAX_SIZE=100
SMTP_CONNECTION_TIMEOUT=5000
SMTP_READ_TIMEOUT=10000
SMTP_WRITE_TIMEOUT=10000

# Non-secret application policy (keep these explicit so a fresh deployment has
# no unresolved Spring placeholders). Replace values marked as secrets.
PORT=8080
JPA_DATABASE_PLATFORM=org.hibernate.dialect.MariaDBDialect
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
JPA_DEFAULT_BATCH_FETCH_SIZE=50
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT=30000
DB_POOL_VALIDATION_TIMEOUT=5000
DB_POOL_LEAK_DETECTION_THRESHOLD=0
APP_JWT_ACCESS_EXP=3600000
APP_JWT_REFRESH_EXP=86400000
ELASTICSEARCH_CONNECTION_TIMEOUT=5000
ELASTICSEARCH_READ_TIMEOUT=30000
ELASTICSEARCH_INDEX_PREFIX=souklab_
ELASTICSEARCH_VERSION=8.15
ELASTICSEARCH_VERSION_CHECK_ENABLED=false
HIBERNATE_SEARCH_SYNC_STRATEGY=write-sync
SEARCH_SYNC_ON_STARTUP=true
SEARCH_MASS_INDEXING_THREADS=2
SEARCH_MASS_INDEXING_BATCH_SIZE=25
SEARCH_MASS_INDEXING_ID_FETCH_SIZE=50
ASYNC_APPLICATION_CORE_POOL_SIZE=4
ASYNC_APPLICATION_MAX_POOL_SIZE=16
ASYNC_APPLICATION_QUEUE_CAPACITY=200
ASYNC_APPLICATION_THREAD_NAME_PREFIX=souklab-async-
ASYNC_WORKFLOW_CORE_POOL_SIZE=8
ASYNC_WORKFLOW_MAX_POOL_SIZE=32
ASYNC_WORKFLOW_QUEUE_CAPACITY=500
ASYNC_WORKFLOW_THREAD_NAME_PREFIX=souklab-workflow-
APP_CACHE_EXPIRE_AFTER_WRITE=60m
APP_CACHE_MAXIMUM_SIZE=1000
APP_STORAGE_UPLOADS=storage/uploads
APP_STORAGE_THUMBNAILS=storage/thumbnails
APP_STORAGE_INDEXES=storage/indexes
APP_STORAGE_FILE_SERVING_PREFIX=/api/v1/files/
MULTIPART_MAX_FILE_SIZE=100MB
MULTIPART_MAX_REQUEST_SIZE=100MB
STORAGE_MAX_FILE_SIZE=15MB
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf
STORAGE_VIRUS_SCAN_HOST=clamav
STORAGE_VIRUS_SCAN_PORT=3310
STORAGE_VIRUS_SCAN_CONNECTION_TIMEOUT=2000ms
STORAGE_VIRUS_SCAN_READ_TIMEOUT=10000ms
STORAGE_RATE_LIMIT_ENABLED=true
STORAGE_RATE_LIMIT_CAPACITY=120
STORAGE_RATE_LIMIT_REFILL_DURATION=1m
AVATAR_MAX_PER_USER=10
AVATAR_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
AVATAR_RATE_LIMIT_ENABLED=true
AVATAR_RATE_LIMIT_CAPACITY=5
AVATAR_RATE_LIMIT_REFILL_DURATION=1m
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
RELAY_HOST=rabbitmq
RELAY_PORT=61613
RELAY_CLIENT_LOGIN=replace-with-rabbit-user
RELAY_CLIENT_PASSCODE=replace-with-rabbit-password
RELAY_SYSTEM_LOGIN=replace-with-rabbit-user
RELAY_SYSTEM_PASSCODE=replace-with-rabbit-password
ANALYTICS_DEFAULT_PAGE_SIZE=20
ANALYTICS_MAXIMUM_PAGE_SIZE=100
ANALYTICS_MAXIMUM_RANGE_DAYS=366
ANALYTICS_MAXIMUM_BUCKET_COUNT=500
ANALYTICS_SUPPORTED_BUCKETS=DAY,WEEK,MONTH,QUARTER
