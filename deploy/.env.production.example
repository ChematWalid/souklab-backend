ANALYTICS_EXPORT_RETENTION=24h
ANALYTICS_RAW_EVENT_RETENTION=90d
ANALYTICS_ROLLUP_RETENTION=730d
ANALYTICS_CLEANUP_INTERVAL=1h
ANALYTICS_CLEANUP_BATCH_SIZE=1000
ANALYTICS_RABBIT_ENABLED=true
ANALYTICS_RABBIT_HOST=rabbitmq
ANALYTICS_RABBIT_PORT=5672
ANALYTICS_RABBIT_USERNAME=replace-with-rabbit-user
ANALYTICS_RABBIT_PASSWORD=replace-with-rabbit-password
ANALYTICS_RABBIT_EXCHANGE=souklab.analytics
