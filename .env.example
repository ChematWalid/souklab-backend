# Server Configuration
PORT=8080
COMPOSE_PROJECT_NAME=souklab
MARIADB_HOST_PORT=3306

# Local-development defaults. Production must supply equivalent values from its secret/configuration store.
# Database Configuration (MariaDB)
DB_NAME=souklab_db
DB_URL=jdbc:mariadb://localhost:3306/souklab_db?createDatabaseIfNotExist=true&useSsl=false&serverTimezone=UTC
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_ROOT_PASSWORD=your_db_root_password
JPA_DATABASE_PLATFORM=org.hibernate.dialect.MariaDBDialect
JPA_HIBERNATE_DDL_AUTO=update
# Use the production profile with JPA_HIBERNATE_DDL_AUTO=validate after applying migrations.
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
JPA_DEFAULT_BATCH_FETCH_SIZE=50
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT=30000
DB_POOL_VALIDATION_TIMEOUT=5000
DB_POOL_LEAK_DETECTION_THRESHOLD=0
FLYWAY_ENABLED=false
PAGEABLE_DEFAULT_SIZE=20
PAGEABLE_MAX_SIZE=100

# JWT Security (Must be at least 256-bit / 32 bytes string for HS256)
APP_JWT_SECRET=your_jwt_secret_key_must_be_at_least_32_characters_long_here
APP_JWT_ACCESS_EXP=3600000
APP_JWT_REFRESH_EXP=86400000

# Hibernate Search & Elasticsearch
HIBERNATE_SEARCH_ENABLED=true
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_CONNECTION_TIMEOUT=5000
ELASTICSEARCH_READ_TIMEOUT=30000
ELASTICSEARCH_INDEX_PREFIX=souklab_
ELASTICSEARCH_VERSION=8.15
ELASTICSEARCH_VERSION_CHECK_ENABLED=false
HIBERNATE_SEARCH_SCHEMA_MANAGEMENT=create-or-update
SEARCH_SCHEMA_BOOTSTRAP_ENABLED=false
HIBERNATE_SEARCH_SYNC_STRATEGY=write-sync
SEARCH_SYNC_ON_STARTUP=true
SEARCH_MASS_INDEXING_THREADS=2
SEARCH_MASS_INDEXING_BATCH_SIZE=25
SEARCH_MASS_INDEXING_ID_FETCH_SIZE=50

# Application execution and cache tuning
ASYNC_APPLICATION_CORE_POOL_SIZE=4
ASYNC_APPLICATION_MAX_POOL_SIZE=16
ASYNC_APPLICATION_QUEUE_CAPACITY=200
ASYNC_APPLICATION_THREAD_NAME_PREFIX=souklab-async-
ASYNC_WORKFLOW_CORE_POOL_SIZE=8
ASYNC_WORKFLOW_MAX_POOL_SIZE=32
ASYNC_WORKFLOW_QUEUE_CAPACITY=500
ASYNC_WORKFLOW_THREAD_NAME_PREFIX=souklab-workflow-
APP_CACHE_EXPIRE_AFTER_WRITE=60m
APP_CACHE_MAXIMUM_SIZE=1000

# File Upload & Storage Locations
APP_STORAGE_UPLOADS=storage/uploads
APP_STORAGE_THUMBNAILS=storage/thumbnails
APP_STORAGE_INDEXES=storage/indexes
APP_STORAGE_FILE_SERVING_PREFIX=/api/v1/files/
MULTIPART_MAX_FILE_SIZE=100MB
MULTIPART_MAX_REQUEST_SIZE=100MB

# File Storage Module (MinIO / S3)
RABBITMQ_DEFAULT_USER=your_rabbitmq_user
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_root_password_here
STORAGE_PROVIDER=s3
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=souklab-files
STORAGE_S3_ACCESS_KEY=your_minio_access_key_here
STORAGE_S3_SECRET_KEY=your_minio_secret_key_here
STORAGE_S3_PATH_STYLE_ACCESS=true
STORAGE_S3_AUTO_CREATE_BUCKET=true
STORAGE_MAX_FILE_SIZE=15MB
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf
STORAGE_VIRUS_SCAN_ENABLED=false
STORAGE_VIRUS_SCAN_HOST=localhost
STORAGE_VIRUS_SCAN_PORT=3310
STORAGE_VIRUS_SCAN_CONNECTION_TIMEOUT=2000ms
STORAGE_VIRUS_SCAN_READ_TIMEOUT=10000ms
STORAGE_VIRUS_SCAN_FAIL_OPEN=false
STORAGE_RATE_LIMIT_ENABLED=true
STORAGE_RATE_LIMIT_CAPACITY=120
STORAGE_RATE_LIMIT_REFILL_DURATION=1m
STORAGE_RATE_LIMIT_CACHE_MAX_SIZE=10000
STORAGE_RATE_LIMIT_CACHE_EXPIRE_AFTER_ACCESS=10m

# User Avatar Configuration
AVATAR_MAX_PER_USER=10
AVATAR_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
AVATAR_RATE_LIMIT_ENABLED=true
AVATAR_RATE_LIMIT_CAPACITY=5
AVATAR_RATE_LIMIT_REFILL_DURATION=1m
AVATAR_RATE_LIMIT_CACHE_MAX_SIZE=1000
AVATAR_RATE_LIMIT_CACHE_EXPIRE_AFTER_ACCESS=10m

# Global API Rate Limiting
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_CAPACITY=100
APP_RATE_LIMIT_REFILL_DURATION=1m
APP_RATE_LIMIT_CACHE_MAX_SIZE=10000
APP_RATE_LIMIT_CACHE_EXPIRE_AFTER_ACCESS=10m

# Mail Configuration (SMTP / MailerSend)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
APP_EMAIL_USE_SMTP=true
MAILERSEND_API_KEY=
MAILERSEND_API_URL=https://api.mailersend.com/v1/email
MAILERSEND_SENDER_EMAIL=noreply@souklab.dz
MAILERSEND_SENDER_NAME=Souklab

# Chargily Pay V2 Integration
CHARGILY_API_KEY=test_api_key_here
CHARGILY_SECRET_KEY=test_secret_key_here
CHARGILY_MODE=test
CHARGILY_WEBHOOK_SECRET=

# Admin Seeder
APP_ADMIN_DEFAULT_EMAIL=admin@souklab.dz
APP_ADMIN_DEFAULT_PASSWORD=your_admin_seed_password_here
APP_ADMIN_BOOTSTRAP_ENABLED=false

# CORS Configuration
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# STOMP Broker Relay (RabbitMQ)
RELAY_HOST=localhost
RELAY_PORT=61613
RELAY_CLIENT_LOGIN=souklab_test
RELAY_CLIENT_PASSCODE=souklab_test_password
RELAY_SYSTEM_LOGIN=souklab_test
RELAY_SYSTEM_PASSCODE=souklab_test_password

# Realtime chat policy and protocol
CHAT_MESSAGE_MAX_LENGTH=4000
CHAT_ATTACHMENT_MAX_COUNT=5
CHAT_MIN_PAGE_SIZE=1
CHAT_DEFAULT_PAGE_SIZE=50
CHAT_MAX_PAGE_SIZE=100
CHAT_CURSOR_LIFETIME=24h
CHAT_TYPING_EVENT_INTERVAL=500ms
CHAT_WEBSOCKET_PROTOCOL_VERSION=v1
CHAT_APPLICATION_DESTINATION_PREFIX=/app
CHAT_USER_DESTINATION_PREFIX=/user
CHAT_MESSAGE_DESTINATION_PREFIX=/queue/chat
CHAT_EVENT_DESTINATION=/queue/chat/events
CHAT_PRESENCE_DESTINATION=/topic/presence
CHAT_NOTIFICATION_DESTINATION=/queue/notifications
CHAT_WEBSOCKET_ENDPOINT=/ws
CHAT_BROKER_DESTINATION_PREFIXES=/topic,/queue
CHAT_UNRESOLVED_USER_DESTINATION=/topic/unresolved-user-destination
CHAT_USER_REGISTRY_BROADCAST=/topic/simp-user-registry
NOTIFICATION_MAX_MESSAGE_LENGTH=4000
FEED_MAX_MEDIA_PER_POST=10
FEED_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp

# Google OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}

# Logging Levels (TRACE, DEBUG, INFO, WARN, ERROR)
APP_LOGGING_LEVEL_ROOT=INFO
APP_LOGGING_LEVEL_APP=DEBUG
APP_LOGGING_LEVEL_SEARCH=INFO
APP_LOGGING_LEVEL_SEARCH_REQUESTS=DEBUG
APP_LOGGING_LEVEL_ELASTICSEARCH=INFO

# Security, Account Lockout & Verification (OTP)
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_VERIFICATION_MAX_ATTEMPTS=5
AUTH_VERIFICATION_EXPIRATION_MINUTES=15
AUTH_VERIFICATION_CODE_LENGTH=6

# Artisan Showcase, Accreditation & Formateur Quotas
ARTISAN_GALLERY_MAX_IMAGES=20
ARTISAN_GALLERY_MAX_FILE_SIZE=10MB
ARTISAN_GALLERY_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
ARTISAN_CERTIFICATION_MAX_COUNT=10
ARTISAN_CERTIFICATION_MAX_FILE_SIZE=15MB
ARTISAN_CERTIFICATION_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
ARTISAN_FORMATEUR_REAPPLY_COOLDOWN_DAYS=14

# -----------------------------------------------------------------------------
# Formations & Masterclasses
# -----------------------------------------------------------------------------
FORMATION_THUMBNAIL_MAX_FILE_SIZE=10MB
FORMATION_THUMBNAIL_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
FORMATION_FILE_MAX_COUNT=10
FORMATION_FILE_MAX_FILE_SIZE=25MB
FORMATION_FILE_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
FORMATION_DEFAULT_CURRENCY=DZD
FORMATION_CANCELLATION_DEADLINE_HOURS=24
FORMATION_DEFAULT_PAGE_SIZE=10

# Artisan directory pagination policy
DIRECTORY_DEFAULT_PAGE_INDEX=0
DIRECTORY_DEFAULT_PAGE_SIZE=20
DIRECTORY_MIN_PAGE_SIZE=1
DIRECTORY_MAX_PAGE_SIZE=100

# Support Contact
APP_SUPPORT_EMAIL=support@souklab.dz
APP_SUPPORT_CONTACT_MESSAGE="Please contact support."

# Admin Reasons
APP_ADMIN_DEFAULT_BAN_REASON=Account banned by administrator
APP_ADMIN_DEFAULT_TIMEOUT_REASON=Account timed out by administrator

# OAuth Cookie
OAUTH_INTENT_COOKIE_MAX_AGE_SECONDS=300
